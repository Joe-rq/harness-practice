{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src"],
      "description": "文件系统访问 - 读写项目代码"
    },
    "filesystem-readonly": {
      "command": "npx", 
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./docs"],
      "description": "只读文件系统 - 访问文档"
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "description": "浏览器自动化 - UI 验证截图"
    },
    "sqlite": {
      "command": "python",
      "args": ["-m", "mcp_server_sqlite", "--db-path", "./.harness/data.db"],
      "description": "SQLite 数据库 - 存储进度和元数据"
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git"],
      "description": "Git 操作 - 读取 git 历史、状态"
    },
    "search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-search"],
      "description": "代码搜索 - 跨文件搜索"
    }
  },
  "tools": {
    "Bash": {
      "enabled": true,
      "timeout": 300
    },
    "Edit": {
      "enabled": true
    },
    "Read": {
      "enabled": true,
      "allowedDirectories": ["./src", "./docs", "./.harness", "./skills"]
    },
    "Write": {
      "enabled": true,
      "allowedDirectories": ["./src", "./docs", "./.harness"]
    },
    "Glob": {
      "enabled": true
    },
    "Grep": {
      "enabled": true
    }
  },
  "hooks": {
    "preCommit": [
      "python skills/architecture-lint/scripts/run_all.py",
      "python skills/code-review/scripts/run_review.py --files src/"
    ],
    "postReview": [
      "python skills/cleanup/scripts/cleanup.py --check-only"
    ]
  },
  "harness": {
    "config": ".harness/config.yaml",
    "progressDir": ".harness/progress",
    "reviewDir": ".harness/reviews"
  }
}
